{
 "title": "Banner stack map",
 "lang": "en",
 "root": {
  "title": "Banner in markdown-editor",
  "essence": "Banner block: Markdown plugins and a visual editor for background, title, description, image and layout; 15 PRs, one commit each."
 },
 "cats": [
  {
   "id": "schema",
   "name": "Schema",
   "desc": "Functions that describe ProseMirror nodes: schema, attributes, banner parts and extension options."
  },
  {
   "id": "md",
   "name": "Markdown",
   "desc": "Functions that handle Markdown: markdown-it plugins, token parsing and writing directives back."
  },
  {
   "id": "model",
   "name": "Model",
   "desc": "Functions that form the data model: value normalization, defaults and HTML/data attributes of the block."
  },
  {
   "id": "cmd",
   "name": "Commands",
   "desc": "Functions that are ProseMirror commands changing the document: attributes, banner parts, undo steps."
  },
  {
   "id": "nav",
   "name": "Cursor",
   "desc": "Functions that handle the cursor, selection and keys: Backspace, Delete, Enter, arrows."
  },
  {
   "id": "guard",
   "name": "Guards",
   "desc": "Functions that guard the banner structure: one part of each type, extra parts unwrapped."
  },
  {
   "id": "text",
   "name": "Text",
   "desc": "Functions that handle typing, pasting and dropping text: one line without marks."
  },
  {
   "id": "dom",
   "name": "DOM",
   "desc": "Functions that handle the editor DOM: NodeView, element attributes, clicks on the block."
  },
  {
   "id": "ui",
   "name": "UI",
   "desc": "Functions that are React components and popovers: settings windows, toolbars, palette, preview, focus and closing."
  },
  {
   "id": "upload",
   "name": "Upload",
   "desc": "Functions that handle images and files: link or file form, upload, cancel."
  }
 ],
